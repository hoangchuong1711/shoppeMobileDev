<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/shopee_bg">
    <TextView
        android:id="@+id/back" android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="@color/white"
        android:text="‹  Đơn hàng của tôi"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout
                android:id="@+id/ordersContainer" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/ordersEmpty" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="80dp"
                android:paddingBottom="40dp"
                android:text="Chưa có đơn hàng&#10;Các đơn đã đặt sẽ xuất hiện tại đây."
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/orderDetail" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="20dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/detailTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:id="@+id/detailDate" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="28dp"
                    android:paddingBottom="12dp"
                    android:text="SẢN PHẨM"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <LinearLayout
                    android:id="@+id/detailProducts" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/legacyItems" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:visibility="gone" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="24dp"
                    android:paddingBottom="12dp"
                    android:text="GIAO ĐẾN"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:id="@+id/detailDelivery" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="24dp"
                    android:paddingBottom="12dp"
                    android:text="THANH TOÁN"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Thanh toán khi nhận hàng (COD)"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:id="@+id/detailTotal" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="24dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
