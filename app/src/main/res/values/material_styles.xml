<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="AppToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/shopee_orange</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/shopee_orange_light</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <style name="AppSearchField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/white</item>
        <item name="boxCornerRadiusTopStart">20dp</item>
        <item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item>
        <item name="boxCornerRadiusBottomEnd">20dp</item>
    </style>
</resources>
