<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFF2EE"
    android:padding="24dp"
    tools:context=".RegisterActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TẠO TÀI KHOẢN"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#EE4D2D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Điền thông tin bên dưới để đăng ký"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp" />

            <EditText
                android:id="@+id/edtRegUsername"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input"
                android:hint="Tên đăng nhập"
                android:paddingHorizontal="16dp"
                android:inputType="text"
                android:textSize="15sp"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/edtRegPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input"
                android:hint="Mật khẩu (tối thiểu 6 ký tự)"
                android:paddingHorizontal="16dp"
                android:inputType="textPassword"
                android:textSize="15sp"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/edtRegConfirm"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input"
                android:hint="Nhập lại mật khẩu"
                android:paddingHorizontal="16dp"
                android:inputType="textPassword"
                android:textSize="15sp"
                android:layout_marginBottom="22dp" />

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Đăng ký"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#EE4D2D" />

            <TextView
                android:id="@+id/tvBackLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã có tài khoản? Đăng nhập"
                android:textColor="#EE4D2D"
                android:textStyle="bold"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
