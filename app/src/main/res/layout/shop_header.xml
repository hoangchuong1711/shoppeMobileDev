<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="56dp"
 android:orientation="horizontal" android:gravity="center_vertical"
 android:paddingHorizontal="12dp" android:background="@color/white">
 <TextView android:id="@+id/headerMenu" android:layout_width="44dp"
  android:layout_height="match_parent" android:gravity="center" android:text="☰"
  android:textSize="25sp" android:textColor="@color/text_primary"
  android:contentDescription="Mở menu" />
 <TextView android:id="@+id/headerBrand" android:layout_width="0dp" android:layout_height="wrap_content"
  android:layout_weight="1" android:text="YaMe.vn" android:textSize="20sp"
  android:textStyle="bold" android:textColor="@color/text_primary" />
 <TextView android:id="@+id/headerSearch" android:layout_width="44dp"
  android:layout_height="match_parent" android:gravity="center" android:text="⌕"
  android:textSize="30sp" android:textColor="@color/text_primary"
  android:contentDescription="Tìm kiếm" />
 <ImageView android:id="@+id/headerCart" android:layout_width="44dp"
  android:layout_height="44dp" android:padding="11dp" android:src="@drawable/ic_cart_white"
  app:tint="@color/text_primary" android:contentDescription="Giỏ hàng" />
</LinearLayout>
