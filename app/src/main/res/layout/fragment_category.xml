<?xml version="1.0" encoding="utf-8"?>
<!-- Giao diện Fragment Danh mục: Thanh trượt ngang danh mục + Grid 2 cột sản phẩm -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Thanh trượt ngang chứa các danh mục -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:scrollbars="none"
        android:paddingVertical="10dp"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/catAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tất cả"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_category_selected"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/catFashion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thời trang"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:background="@drawable/bg_category_unselected"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/catConsumer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiêu dùng"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:background="@drawable/bg_category_unselected"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/catHealth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sức khỏe"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:background="@drawable/bg_category_unselected"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/catTech"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Công nghệ"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:background="@drawable/bg_category_unselected"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginHorizontal="4dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvCategoryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Danh mục: Tất cả sản phẩm"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#EE4D2D"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <!-- Danh sách sản phẩm của danh mục được chọn (Grid 2 cột) -->
    <GridView
        android:id="@+id/gvCategoryProducts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:numColumns="2"
        android:horizontalSpacing="6dp"
        android:verticalSpacing="6dp"
        android:padding="8dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

</LinearLayout>
